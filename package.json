{
  "name": "lorecraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lorecraft application monorepo",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "generate:contracts": "npm run build --workspace @lorecraft/backend -- --ignore-ts-errors",
    "check:contracts": "git diff --exit-code -- apps/backend/.adonisjs/client && test -z \"$(git status --porcelain --untracked-files=all -- apps/backend/.adonisjs/client)\"",
    "verify:contracts": "npm run generate:contracts && npm run check:contracts",
    "test": "turbo test",
    "test:e2e": "playwright test --config apps/frontend/playwright.config.ts",
    "test:storybook": "npm run test:storybook --workspace @lorecraft/frontend",
    "test:containers": "node --test deploy/container-contract.test.mjs",
    "test:images": "node --test scripts/image-workflow.test.mjs",
    "test:deployment": "node --test deploy/release-command.test.mjs",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "storybook": "npm run storybook --workspace @lorecraft/frontend",
    "build:storybook": "npm run build-storybook --workspace @lorecraft/frontend"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.5.0",
    "agent-browser": "^0.32.3",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16"
  },
  "packageManager": "npm@11.12.1",
  "prettier": "@adonisjs/prettier-config"
}
