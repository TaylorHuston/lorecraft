{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "APP_KEY",
    "APP_URL",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "ALLOW_TEST_DATABASE_WRITES",
    "ALLOW_E2E_DATABASE_WRITES",
    "HOST",
    "PORT",
    "LOG_LEVEL",
    "SESSION_DRIVER",
    "VITE_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".adonisjs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
