# Node
TZ=UTC
PORT=4311
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
CORS_ORIGIN=http://localhost:4310

# Database
DATABASE_URL=
# Direct connection for explicit one-shot production migrations only.
MIGRATION_DATABASE_URL=

# Story generation worker (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-provider
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.8
LLM_REASONING_EFFORT=
ADVENTURE_WORKER_POLL_INTERVAL_MS=1000
# Development-only local trace. It refuses production and writes only to tmp/debug.
LORECRAFT_DEBUG_TRACE=1
LORECRAFT_DEBUG_TRACE_RAW_REQUEST=1
LORECRAFT_DEBUG_TRACE_RAW_RESPONSE=1

# Session
SESSION_DRIVER=database
