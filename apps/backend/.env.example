# Node
TZ=UTC
PORT=4311
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
CORS_ORIGIN=http://localhost:4310

# Database
DATABASE_URL=

# Story generation worker (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-provider
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.8
ADVENTURE_WORKER_POLL_INTERVAL_MS=1000

# Session
SESSION_DRIVER=database
