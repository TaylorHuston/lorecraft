# Copy to deploy/.env.production on the host and restrict it to root (mode 0600).
# Use immutable commit-SHA image tags. Do not put real values in this template.
IMAGE_REPOSITORY=ghcr.io/owner/lorecraft
GATEWAY_PORT=8080

NODE_ENV=production
HOST=0.0.0.0
PORT=4311
LOG_LEVEL=info
APP_KEY=<generate-a-unique-production-key>
APP_URL=https://<private-tailscale-hostname>
CORS_ORIGIN=https://<private-tailscale-hostname>
SESSION_DRIVER=database

# Runtime processes use the pooled Neon connection. Migration tooling receives
# a separately injected direct connection when the release command is run.
DATABASE_URL=postgresql://<pooled-runtime-connection>
MIGRATION_DATABASE_URL=postgresql://<direct-migration-connection>
STARTER_WORLD_AUTHOR_EMAIL=<production-account-email>

LLM_BASE_URL=https://<private-provider-endpoint>/v1
LLM_API_KEY=<provider-key>
LLM_MODEL=<model-name>
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.8
LLM_REASONING_EFFORT=none
